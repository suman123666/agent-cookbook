# 复制本文件为 .env 并填入你的真实配置
# 你用的是 OpenAI 兼容的中转/代理渠道来调用 Claude

# 中转渠道给你的 API key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 中转渠道的接口地址（通常以 /v1 结尾，具体看你的渠道文档）
OPENAI_BASE_URL=https://your-relay-station.example.com/v1

# 在你的渠道里 Claude 模型叫什么名字（不同中转站命名可能不同）
# 常见：claude-sonnet-4-6 / claude-3-5-sonnet / claude-3-7-sonnet 等
MODEL=claude-sonnet-4-6
