# ─── 复制本文件为 .env 并填入真实配置 ───
# 本项目用 OpenAI 兼容 API，下面给出常见渠道的配置示例

# ════════════════════════════════════════════════════════════
# 必填：LLM 接口
# ════════════════════════════════════════════════════════════

# API key（任意 OpenAI 兼容渠道）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# API 接口地址（通常以 /v1 结尾）
OPENAI_BASE_URL=https://your-relay-station.example.com/v1

# 模型名称（看你的渠道支持什么）
# - OpenAI 官方:       gpt-4o / gpt-4o-mini / o1
# - Anthropic 中转:    claude-sonnet-4-6 / claude-3-5-sonnet 等
# - 通义千问:          qwen-plus / qwen-max / qwen-turbo
# - DeepSeek:          deepseek-chat / deepseek-coder
# - 智谱:              glm-4-plus / glm-4-flash
MODEL=claude-sonnet-4-6

# ════════════════════════════════════════════════════════════
# 第 5 章 RAG 必填：Embedding 模型
# ════════════════════════════════════════════════════════════

# Embedding 模型名（看你的渠道支持什么）
# - OpenAI 官方:    text-embedding-3-small / text-embedding-3-large
# - 通义千问:        text-embedding-v3 / text-embedding-v4
# - 智谱:            embedding-3
EMBED_MODEL=text-embedding-3-small

# Embedding batch size 限制（避免渠道报错）
# - OpenAI 官方:    可以 100+
# - 通义/部分中转:   通常限制 10（默认值）
EMBED_BATCH_SIZE=10
